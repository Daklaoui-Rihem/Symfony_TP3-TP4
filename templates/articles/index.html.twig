{# templates/articles/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}
    <div class="container my-4">
        <h1>Liste des articles</h1>
        
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}
        
        <table id="articles" class="table table-striped">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prix</th>
                    <th>Catégorie</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for article in articles %}
                    <tr>
                        <td>{{ article.nom }}</td>
                        <td>{{ article.prix }}</td>
                        <td>{{ article.category.titre }}</td>
                        <td>
                            <a href="{{ path('article_show', {'id': article.id}) }}" class="btn btn-sm btn-dark">Détails</a>
                            <a href="{{ path('article_edit', {'id': article.id}) }}" class="btn btn-sm btn-dark">Modifier</a>
                            <a href="{{ path('article_delete', {'id': article.id}) }}" class="btn btn-sm btn-danger"
                               onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet article?');">Supprimer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        
        <div class="mt-3">
            <a href="{{ path('new_article') }}" class="btn btn-primary">Ajouter un article</a>
            <a href="{{ path('new_category') }}" class="btn btn-secondary">Ajouter une catégorie</a>
        </div>
    </div>
{% endblock %}