{# templates/articles/newCategory.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Ajouter une catégorie{% endblock %}

{% block body %}
    <div class="container my-4">
        <h1>Ajouter une nouvelle catégorie</h1>
        
        {{ form_start(form, {'attr': {'class': 'my-3'}}) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-success mt-3">Créer</button>
        {{ form_end(form) }}
        
        <a href="{{ path('article_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
    </div>
{% endblock %}